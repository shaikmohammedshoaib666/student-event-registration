# Copy this file to .streamlit/secrets.toml for local development.
# In Streamlit Community Cloud, add these values in App settings > Secrets.
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY = "your-server-side-service-role-key"
SUPABASE_STORAGE_BUCKET = "event-photos"
APP_TIMEZONE = "UTC"

# Configure one to three admin accounts with real email addresses and
# different, unique passwords. Replace every example value before deploying.
[ADMIN_USERS]
"admin1@university.edu" = "replace-with-a-unique-long-password-1"
"admin2@university.edu" = "replace-with-a-unique-long-password-2"
"admin3@university.edu" = "replace-with-a-unique-long-password-3"
